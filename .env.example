# Credencial del proveedor LLM (solo backend, nunca en el repo ni el front).
# Acepta clave de API (sk-ant-api03-...) o token OAuth (sk-ant-oat01-...); se detecta por el prefijo.
ANTHROPIC_API_KEY=
# Modelo (por defecto claude-opus-5-5)
LLM_MODEL=claude-opus-5-5
# Puerto HTTP
PORT=3000
# Topes de costo
MAX_ITERACIONES=25
MAX_TOKENS_SESION=300000
LLM_TIMEOUT_MS=90000
